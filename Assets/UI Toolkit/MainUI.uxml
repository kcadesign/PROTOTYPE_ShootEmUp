    <ui:VisualElement name="MainMenu" focusable="false" style="flex-grow: 1; background-color: rgb(0, 0, 255); width: 100%; height: 100%; align-content: auto; justify-content: center; display: none; visibility: visible;">
        <ui:VisualElement name="ButtonContainer" focusable="false" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; scale: 1 1; justify-content: center; align-self: center; align-content: center; align-items: center; width: 647px; height: 50%; aspect-ratio: auto; max-height: 76%; max-width: 100%; min-height: 0; min-width: 0%;">
            <ui:Button text="START GAME" name="StartButton" selectable="true" enabled="true" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 30%; width: 100%; aspect-ratio: auto; max-width: 75%; max-height: 75px;"/>
