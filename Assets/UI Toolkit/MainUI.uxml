    <ui:VisualElement name="Experience" style="flex-grow: 1; display: none; background-color: rgba(0, 0, 0, 0.5);">
        <ui:VisualElement name="ExperiencePanel" style="flex-grow: 1; margin-top: 10%; margin-right: 25%; margin-bottom: 10%; margin-left: 25%; background-color: rgb(0, 0, 255); justify-content: center; align-items: center; align-self: stretch; align-content: center;">
            <ui:VisualElement name="TextContainer" style="flex-grow: 1; flex-direction: row; width: 80%; justify-content: space-between; align-items: flex-end; height: 117px; align-self: auto; max-height: 10%; min-height: auto;">
                <ui:Label text="LEVEL 999" name="LevelText" selectable="false" focusable="false" parse-escape-sequences="true" class="progressBar_label"/>
                <ui:Label text="999 STARS / 999 STARS " name="XPText" selectable="false" focusable="false" class="progressBar_label" style="-unity-text-align: upper-right; display: none;"/>
            </ui:VisualElement>
            <ui:ProgressBar value="35.4" title="my-progress" data-source="project://database/Assets/_Scripts/Player/PlayerStatsData.asset?fileID=11400000&amp;guid=b2fb527e51a842f44874ab8d4b14c143&amp;type=2#PlayerStatsData">
                <Bindings>
                    <ui:DataBinding property="lowValue" data-source-path="_lowValue" binding-mode="ToTarget"/>
                    <ui:DataBinding property="highValue" data-source-path="_highValue" binding-mode="ToTarget"/>
                    <ui:DataBinding property="value" data-source-path="_value" binding-mode="ToTarget"/>
                </Bindings>
            </ui:ProgressBar>
