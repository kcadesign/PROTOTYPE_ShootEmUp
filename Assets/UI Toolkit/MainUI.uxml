        <ui:VisualElement name="BottomBlock" style="flex-grow: 1; margin-bottom: 24px; padding-bottom: 0; background-color: rgba(34, 117, 255, 0); margin-top: 24px; justify-content: space-between; align-items: flex-end; flex-direction: row; align-self: auto; align-content: stretch;">
            <ui:VisualElement name="LeftColumn" style="flex-grow: 1; margin-right: 20px; background-color: rgba(192, 59, 59, 0); align-items: flex-start; width: 25%; height: 100%; justify-content: flex-end; flex-direction: column; align-self: flex-start;">
                <ui:VisualElement name="StatsContainer" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0.25); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; width: 100%; height: 20%; max-height: 50%; justify-content: space-around; align-content: center; align-self: flex-start; align-items: flex-start;">
